{
  "private": true,
  "name": "pmide-ext",
  "version": "1.73.100",
  "description": "PMIDE — the product-management IDE: Ask, Specs, Workflows, Code, and Context surfaces over linked repos, powered by Claude Code",
  "dependencies": {
    "@theia/core": "1.73.1",
    "@theia/filesystem": "1.73.1",
    "@theia/workspace": "1.73.1",
    "@theia/editor": "1.73.1",
    "@theia/monaco": "1.73.1",
    "@theia/navigator": "1.73.1",
    "@theia/output": "1.73.1",
    "@theia/scm": "1.73.1",
    "inversify": "^6.2.2"
  },
  "devDependencies": {
    "rimraf": "^2.7.1",
    "typescript": "^4.9.5"
  },
  "theiaExtensions": [
    {
      "frontend": "lib/browser/pmide-frontend-module",
      "backend": "lib/node/pmide-backend-module"
    }
  ],
  "keywords": [
    "theia-extension"
  ],
  "license": "MIT",
  "files": [
    "lib",
    "src"
  ],
  "scripts": {
    "clean": "rimraf lib *.tsbuildinfo",
    "build": "tsc -b",
    "lint": "eslint --ext js,jsx,ts,tsx src",
    "lint:fix": "eslint --ext js,jsx,ts,tsx src --fix",
    "update:theia": "ts-node ../../scripts/update-theia-version.ts",
    "update:next": "ts-node ../../scripts/update-theia-version.ts next"
  },
  "peerDependencies": {
    "react": "^18.3.1"
  }
}
